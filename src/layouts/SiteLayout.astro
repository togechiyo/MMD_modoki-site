---
import '../styles/site.css';
import GuideNav from '../components/GuideNav.astro';
import { locales, repository, release, url } from '../data/site';
import { languages, routeInfo, localizedUrl } from '../i18n/config';
interface Props {
  title: string;
  description: string;
  active?: string;
}
const { title, description, active = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const route = routeInfo(Astro.url.pathname, import.meta.env.BASE_URL);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | MMD_modoki</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101010" />
    <link rel="canonical" href={canonical} />
    {
      languages.map((language) => (
        <link
          rel="alternate"
          hreflang={language.locale}
          href={
            new URL(
              localizedUrl(
                import.meta.env.BASE_URL,
                language.locale,
                route.slug,
              ),
              Astro.site,
            )
          }
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(
        localizedUrl(import.meta.env.BASE_URL, 'ja', route.slug),
        Astro.site,
      )}
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={url('favicon.svg').replace(/\/$/, '')}
    />
    <meta property="og:title" content={`${title} | MMD_modoki`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={url()} aria-label="MMD_modoki トップ"
          ><span class="brand-symbol" aria-hidden="true">m<span>.</span></span
          ><span>MMD<span class="brand-divider">_</span>modoki</span></a
        >
        <nav aria-label="メインナビゲーション">
          {
            locales.ja.nav.map((item) => (
              <a
                href={url(item.slug)}
                aria-current={active === item.slug ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <nav class="language-switch" aria-label="言語">
          {
            languages.map((language) => (
              <a
                data-locale-switch={language.locale}
                href={localizedUrl(
                  import.meta.env.BASE_URL,
                  language.locale,
                  route.slug,
                )}
                lang={language.locale}
                hreflang={language.locale}
                aria-current={
                  route.locale === language.locale ? 'true' : undefined
                }
              >
                {language.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main id="main">
      {
        [
          'guide',
          'manual',
          'faq',
          'workflow',
          'formats',
          'effects',
          'glossary',
        ].includes(active) && <GuideNav active={active} />
      }
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <a class="footer-brand" href={url()}>MMD_modoki<span>.</span></a><p>
            MMDの編集を、もっと身近に。
          </p>
        </div><div class="footer-links">
          <a href={repository}>GitHub ↗</a><a href={`${repository}/releases`}
            >Releases ↗</a
          ><a href={`${repository}/issues`}>不具合の報告 ↗</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span
          >アプリ本体: MIT License · 素材の利用規約は各配布者に従ってください。</span
        ><span>掲載情報確認: {release.checked}</span>
      </div>
    </footer>
  </body>
</html>
<script>
  const syncLanguageHash = () =>
    document
      .querySelectorAll<HTMLAnchorElement>('[data-locale-switch]')
      .forEach((link) => {
        const target = new URL(link.href);
        target.hash = location.hash;
        link.href = target.href;
      });
  syncLanguageHash();
  window.addEventListener('hashchange', syncLanguageHash);
</script>
