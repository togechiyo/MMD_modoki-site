---
import '../styles/site.css';
import GuideNav from '../components/GuideNav.astro';
import { locales, repository, release, url } from '../data/site';
interface Props {
  title: string;
  description: string;
  active?: string;
}
const { title, description, active = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | MMD_modoki</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101010" />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={url('favicon.svg').replace(/\/$/, '')}
    />
    <meta property="og:title" content={`${title} | MMD_modoki`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={url()} aria-label="MMD_modoki トップ"
          ><span class="brand-symbol" aria-hidden="true">m<span>.</span></span
          ><span>MMD<span class="brand-divider">_</span>modoki</span></a
        >
        <nav aria-label="メインナビゲーション">
          {
            locales.ja.nav.map((item) => (
              <a
                href={url(item.slug)}
                aria-current={active === item.slug ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <span class="language">JA <span aria-hidden="true">/</span> 日本語</span
        >
      </div>
    </header>
    <main id="main">
      {
        [
          'guide',
          'manual',
          'faq',
          'workflow',
          'formats',
          'effects',
          'glossary',
        ].includes(active) && <GuideNav active={active} />
      }
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <a class="footer-brand" href={url()}>MMD_modoki<span>.</span></a><p>
            MMDの編集を、もっと身近に。
          </p>
        </div><div class="footer-links">
          <a href={repository}>GitHub ↗</a><a href={`${repository}/releases`}
            >Releases ↗</a
          ><a href={`${repository}/issues`}>不具合の報告 ↗</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span
          >アプリ本体: MIT License · 素材の利用規約は各配布者に従ってください。</span
        ><span>掲載情報確認: {release.checked}</span>
      </div>
    </footer>
  </body>
</html>
