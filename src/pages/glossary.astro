---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { glossaryGroups, terms } from '../data/glossary';
import { source, url } from '../data/site';
const byId = new Map(terms.map((term) => [term.id, term]));
const sourceHref = (path: string) => {
  const [file, anchor] = path.split('#');
  return source(file) + (anchor ? `#${anchor}` : '');
};
---

<SiteLayout
  title="用語・パラメータ辞典"
  description="カメラの距離Dと位置Z、ボーン、モーフ、補間、照明、アクセサリの数値欄を、場所と変化から調べるv0.2.4の辞典。"
  active="glossary"
>
  <PageHeader
    label="TERMS & PARAMETERS"
    title="この値を変えると、どうなる？"
    description="画面の言葉を、使う場面と変化で調べる。カメラのDとZから、ボーン・照明・アクセサリの数値欄まで。"
  />
  <div class="wrap content glossary-layout">
    <form
      class="glossary-search"
      id="glossary-search"
      role="search"
      aria-label="辞典内検索"
      hidden
    >
      <div class="glossary-search-fields">
        <label for="term-query"
          >用語・UI名・困っていること<input
            id="term-query"
            type="search"
            placeholder="例：距離、位置Z、モーフ、丸め"
            aria-controls="term-results"
          /></label
        >
        <label for="term-category"
          >カテゴリ<select id="term-category" aria-controls="term-results"
            ><option value="">すべて</option>{
              glossaryGroups.map((g) => <option value={g.id}>{g.name}</option>)
            }</select
          ></label
        >
        <button type="reset" class="button secondary">絞り込みをリセット</button
        >
      </div><p
        id="term-count"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        {terms.length}件を表示
      </p>
    </form>
    <p class="glossary-version">
      <span class="badge">v0.2.4</span> 日本語UIと公開タグの実装を照合 · 2026-10-05確認
    </p>
    <p>
      各項目は「画面の名前」「場所」「意味」「変えたとき」「単位・制約」の順で読めます。数字の範囲はUI定義を示しています。未リリース版の変更を含まず、全OSでの実機動作を保証するものではありません。
    </p>
    <nav class="glossary-quick" aria-label="よく迷う用語">
      <a href="#camera-distance">DとZの違い</a><a href="#perspective"
        >パースとは</a
      ><a href="#input-precision">数値が丸められる？</a><a href="#keyframe"
        >確定と登録の違い</a
      >
    </nav>
    <aside class="notice">
      <strong>入力の異常と、設定の意味を分けて確認してください。</strong><p>
        <a href="https://github.com/togechiyo/MMD_modoki/issues/28">Issue #28</a
        >には数値再入力や投影の出力に関する報告があります。ここでは正常仕様や修正済みとは扱いません。報告環境での再現確認は未実施です。重要な作業は別名保存し、入力確定とキー登録の前後を確認してください。
      </p>
    </aside>
    <noscript
      ><p class="notice">
        JavaScriptが無効なため検索は使えません。カテゴリと各項目の関連リンクから、すべての用語を読めます。
      </p></noscript
    >
    <nav class="glossary-categories" aria-label="辞典のカテゴリ">
      {
        glossaryGroups.map((g) => (
          <a href={`#category-${g.id}`} data-category-link={g.id}>
            {g.name}
          </a>
        ))
      }
    </nav>
    <p id="term-empty" class="notice" hidden>
      一致する項目がありません。別の言葉で検索するか、カテゴリを「すべて」に戻してください。
    </p>
    <div id="term-results">
      {
        glossaryGroups.map((g) => (
          <section id={`category-${g.id}`} class="term-group" data-term-group>
            <>
              <h2>{g.name}</h2>
              <div class="term-grid">
                {terms
                  .filter((t) => t.group === g.id)
                  .map((t) => (
                    <article
                      class="term-card"
                      id={t.id}
                      data-term-card
                      data-category={t.group}
                      data-aliases={t.aliases}
                      data-search={[
                        t.name,
                        t.ui,
                        t.where,
                        t.meaning,
                        t.change,
                        t.limits,
                        t.note ?? '',
                        t.aliases,
                      ].join(' ')}
                    >
                      <h3>
                        <a
                          href={`#${t.id}`}
                          aria-label={`${t.name}の固定リンク`}
                        >
                          {t.name}
                          <span aria-hidden="true"> #</span>
                        </a>
                      </h3>
                      <dl>
                        <dt>画面の名前</dt>
                        <dd class="term-ui">{t.ui}</dd>
                        <dt>場所</dt>
                        <dd>{t.where}</dd>
                        <dt>意味</dt>
                        <dd>{t.meaning}</dd>
                        <dt>変えたとき</dt>
                        <dd>{t.change}</dd>
                        <dt>単位・制約</dt>
                        <dd>{t.limits}</dd>
                        {t.note && (
                          <>
                            <dt>注意</dt>
                            <dd>{t.note}</dd>
                          </>
                        )}
                      </dl>
                      <div class="term-related">
                        <span>関連：</span>
                        {t.related.map((id) => (
                          <a href={`#${id}`}>{byId.get(id)?.name}</a>
                        ))}
                      </div>
                      {t.guide && (
                        <p>
                          <a href={url(t.guide.slug) + `#${t.guide.anchor}`}>
                            {t.guide.label} ↗
                          </a>
                        </p>
                      )}
                      <details class="term-source">
                        <summary>v0.2.4の確認元</summary>
                        <ul>
                          {t.sources.map((path) => (
                            <li>
                              <a href={sourceHref(path)}>{path} ↗</a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    </article>
                  ))}
              </div>
            </>
          </section>
        ))
      }
    </div>
    <div class="next-link">
      <a href={url('manual')}>操作マニュアルへ ↗</a><a href={url('effects')}
        >エフェクトの選び方へ ↗</a
      >
    </div>
  </div>
</SiteLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#glossary-search');
  const input = document.querySelector<HTMLInputElement>('#term-query');
  const category = document.querySelector<HTMLSelectElement>('#term-category');
  const count = document.querySelector('#term-count');
  const empty = document.querySelector<HTMLElement>('#term-empty');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-term-card]')];
  const normalize = (v: string) => v.normalize('NFKC').toLocaleLowerCase('ja');
  const searchable = cards.map((card) => ({
    card,
    text: normalize(card.dataset.search ?? ''),
  }));
  const filter = () => {
    const words = normalize(input?.value.trim() ?? '')
      .split(/\s+/)
      .filter(Boolean);
    let shown = 0;
    for (const { card, text } of searchable) {
      card.hidden =
        Boolean(category?.value && card.dataset.category !== category.value) ||
        !words.every((word) =>
          /^[a-z]$/.test(word)
            ? new RegExp(`(^|[^a-z0-9])${word}($|[^a-z0-9])`).test(text)
            : text.includes(word),
        );
      if (!card.hidden) shown++;
    }
    document.querySelectorAll<HTMLElement>('[data-term-group]').forEach((g) => {
      g.hidden = ![...g.querySelectorAll<HTMLElement>('[data-term-card]')].some(
        (c) => !c.hidden,
      );
    });
    if (count) count.textContent = `${shown} / ${cards.length}件を表示`;
    if (empty) empty.hidden = shown > 0;
  };
  const reset = () => {
    if (input) input.value = '';
    if (category) category.value = '';
    filter();
  };
  form?.addEventListener('submit', (e) => e.preventDefault());
  form?.addEventListener('reset', (e) => {
    e.preventDefault();
    reset();
  });
  input?.addEventListener('input', filter);
  category?.addEventListener('change', filter);
  document
    .querySelectorAll<HTMLAnchorElement>('[data-category-link]')
    .forEach((link) =>
      link.addEventListener('click', () => {
        if (input) input.value = '';
        if (category) category.value = link.dataset.categoryLink ?? '';
        filter();
      }),
    );
  document
    .querySelectorAll<HTMLAnchorElement>('.term-related a, .glossary-quick a')
    .forEach((link) => link.addEventListener('click', reset));
  const revealHash = () => {
    const target = document.getElementById(
      decodeURIComponent(location.hash.slice(1)),
    );
    if (target?.matches('[data-term-card]') && target.hidden) {
      reset();
      target.scrollIntoView();
    }
  };
  window.addEventListener('hashchange', revealHash);
  if (form) form.hidden = false;
  filter();
  revealHash();
</script>
