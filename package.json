{
  "name": "mmd-modoki-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "typecheck": "node scripts/astro.mjs check",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "check:links": "node scripts/check-links.mjs",
    "check:browser": "node scripts/check-browser.mjs"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "axe-core": "4.13.0",
    "playwright": "1.63.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
